{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "baseUrl": ".",
    "paths": {
      "@acme/core": ["packages/core/src/index.ts"],
      "@acme/core/*": ["packages/core/src/*"]
    }
  },
  "include": ["packages/*/src"]
}
